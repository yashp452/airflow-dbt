AIRFLOW__SECRETS__BACKEND=airflow.providers.amazon.aws.secrets.secrets_manager.SecretsManagerBackend
AIRFLOW__SECRETS__BACKEND_KWARGS={"connections_prefix": "airflow/connections", "variables_prefix": "airflow/variables"}
AWS_DEFAULT_REGION=us-west-2

AIRFLOW_CONN_AWS_DEFAULT=aws://
# edit this field with the key/secret you get from DataExpert.io
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# edit SCHEMA/STUDENT_SCHEMA field, for example SCHEMA='john'; STUDENT_SCHEMA='john'

SCHEMA=your_schema
STUDENT_SCHEMA=your_schema

# Snowflake configurations (go to dataexpert credentials tab for this)
# Snowflake: use key-pair auth or password
SNOWFLAKE_ACCOUNT=LYWBBPJ-ODB66944
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
# Key-pair auth: path to your rsa_key.p8 file
# Refer the instructions here - https://github.com/DataExpert-io/airflow-dbt-project/blob/main/README.md#-steps-to-generate-your-keys
PRIVATE_KEY_PATH=/path/to/key/rsa_key.p8
# Passphrase for encrypted .p8 key; leave empty if key is not encrypted
PRIVATE_KEY_PASSPHRASE=

# dbt configurations
DBT_PROFILES_DIR=.
DBT_PROJECT_DIR=.
DBT_PARTIAL_PARSE=False

# ASK THE TAs for these Keys
SEC_API_KEY=
MASSIVE_API_KEY=
